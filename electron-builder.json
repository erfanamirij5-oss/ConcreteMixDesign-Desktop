{
  "appId": "ir.tolou.concreteMixDesign",
  "productName": "Tolou Concrete Mix Design",
  "copyright": "Copyright © 2026 Tolou. All rights reserved.",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist-engine/tolou-mix-engine.exe",
      "to": "engine/tolou-mix-engine.exe"
    },
    {
      "from": "build/tolou-canonical.png",
      "to": "branding/tolou-canonical.png"
    }
  ],
  "extraFiles": [
    {
      "from": "database/migrations",
      "to": "database/migrations",
      "filter": ["*.sql"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Tolou-Concrete-Mix-Design-${version}-Setup.${ext}",
    "executableName": "TolouConcreteMixDesign",
    "icon": "build/tolou.generated.ico",
    "legalTrademarks": "Tolou",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/tolou.generated.ico",
    "uninstallerIcon": "build/tolou.generated.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "طلوع بتن",
    "uninstallDisplayName": "Tolou Concrete Mix Design ${version}",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  }
}
