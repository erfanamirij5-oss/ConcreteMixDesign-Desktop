{
  "appId": "ir.tolou.concreteMixDesign",
  "productName": "Tolou Concrete Mix Design",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist-engine/tolou-mix-engine.exe",
      "to": "engine/tolou-mix-engine.exe"
    }
  ],
  "extraFiles": [
    {
      "from": "database/migrations",
      "to": "database/migrations",
      "filter": ["*.sql"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Tolou-Concrete-Mix-Design-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "طلوع بتن"
  }
}
