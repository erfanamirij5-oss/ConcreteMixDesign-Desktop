{
  "appId": "ir.tolou.licenseManager",
  "productName": "Tolou License Manager",
  "copyright": "Copyright © 2026 Tolou. All rights reserved.",
  "directories": { "output": "release-license-manager" },
  "files": ["apps/license-manager/**/*"],
  "extraResources": [
    { "from": "build/tolou-standard.ico", "to": "branding/tolou-standard.ico" }
  ],
  "extraMetadata": { "main": "apps/license-manager/main.js" },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "artifactName": "Tolou-License-Manager-${version}-Setup.${ext}",
    "executableName": "TolouLicenseManager",
    "icon": "build/tolou-standard.ico",
    "legalTrademarks": "Tolou",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/tolou-standard.ico",
    "uninstallerIcon": "build/tolou-standard.ico",
    "installerHeaderIcon": "build/tolou-standard.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Tolou License Manager",
    "uninstallDisplayName": "Tolou License Manager ${version}",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  }
}
