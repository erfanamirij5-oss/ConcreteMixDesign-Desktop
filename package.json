{
  "name": "concrete-mix-design-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Tolou Concrete Mix Design Desktop - professional concrete mix design software for Windows.",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev:ui": "vite --config apps/desktop/vite.config.ts",
    "build:ui": "vite build --config apps/desktop/vite.config.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:ui && npm run build:electron",
    "build:engine:win": "python -m pip install -e \"engine/python[build]\" && python -m PyInstaller --noconfirm --clean --onefile --name tolou-mix-engine --distpath dist-engine --workpath build-engine --specpath build-engine --paths engine/python/src engine/python/src/tolou_mix_engine/cli.py",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:engine": "cd engine/python && python -m pytest",
    "test:sqlite-material": "npm run build:electron && node dist/electron/materialPersistenceSmoke.js",
    "test:management-migrations": "npm run build:electron && node dist/electron/managementMigrationSmoke.js",
    "test:management-workflow": "npm run build:electron && node dist/electron/managementWorkflowSmoke.js",
    "test:duplicate-contract": "npm run build:electron && node dist/electron/duplicateContractSmoke.js",
    "test:data-integrity-upgrade": "npm run build:electron && node dist/electron/dataIntegrityUpgradeSmoke.js",
    "test:data-integrity-constraints": "npm run build:electron && node dist/electron/dataIntegrityConstraintsSmoke.js",
    "test:data-path-contract": "npm run build:electron && node dist/electron/dataPathContractSmoke.js",
    "test:database-compatibility": "npm run build:electron && node dist/electron/databaseCompatibilitySmoke.js",
    "test:data-integrity-atomicity": "npm run build:electron && node dist/electron/dataIntegrityAtomicitySmoke.js",
    "test:calculation-persistence": "npm run build:electron && node dist/electron/calculationResultPersistenceSmoke.js",
    "test:revision-immutability": "npm run build:electron && node dist/electron/mixDesignImmutabilitySmoke.js",
    "test:material-library-snapshot": "npm run build:electron && node dist/electron/materialLibrarySnapshotSmoke.js",
    "dist:win": "npm run build && npm run build:engine:win && electron-builder --config electron-builder.json --win"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "echarts": "latest",
    "better-sqlite3": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "cross-env": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  },
  "keywords": [
    "concrete",
    "mix-design",
    "aci",
    "electron",
    "react",
    "python",
    "sqlite"
  ],
  "author": "Erfan Amiri / Tolou",
  "license": "UNLICENSED"
}
