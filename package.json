{
  "name": "concrete-mix-design-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Tolou Concrete Mix Design Desktop - professional concrete mix design software for Windows.",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev:ui": "vite --config apps/desktop/vite.config.ts",
    "build:ui": "vite build --config apps/desktop/vite.config.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:ui && npm run build:electron",
    "build:engine:win": "python -m pip install -e \"engine/python[build]\" && python -m PyInstaller --noconfirm --clean --onefile --name tolou-mix-engine --distpath dist-engine --workpath build-engine --specpath build-engine --paths engine/python/src engine/python/src/tolou_mix_engine/cli.py",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:renderer-build": "node tools/renderer-build-smoke.mjs",
    "test:engine": "cd engine/python && python -m pytest",
    "test:sqlite-material": "npm run build:electron && node dist/electron/materialPersistenceSmoke.js",
    "test:management-migrations": "npm run build:electron && node dist/electron/managementMigrationSmoke.js",
    "test:management-workflow": "npm run build:electron && node dist/electron/managementWorkflowSmoke.js",
    "test:duplicate-contract": "npm run build:electron && node dist/electron/duplicateContractSmoke.js",
    "test:data-integrity-upgrade": "npm run build:electron && node dist/electron/dataIntegrityUpgradeSmoke.js",
    "test:data-integrity-constraints": "npm run build:electron && node dist/electron/dataIntegrityConstraintsSmoke.js",
    "test:data-path-contract": "npm run build:electron && node dist/electron/dataPathContractSmoke.js",
    "test:database-compatibility": "npm run build:electron && node dist/electron/databaseCompatibilitySmoke.js",
    "test:v11-persistence-contract": "npm run build:electron && node dist/electron/v11PersistenceContractSmoke.js",
    "test:data-integrity-atomicity": "npm run build:electron && node dist/electron/dataIntegrityAtomicitySmoke.js",
    "test:calculation-persistence": "npm run build:electron && node dist/electron/calculationResultPersistenceSmoke.js",
    "test:revision-immutability": "npm run build:electron && node dist/electron/mixDesignImmutabilitySmoke.js",
    "test:material-library-snapshot": "npm run build:electron && node dist/electron/materialLibrarySnapshotSmoke.js",
    "test:material-intelligence": "npm run build:electron && node dist/electron/materialIntelligenceSmoke.js",
    "test:material-intelligence-snapshot": "npm run build:electron && node dist/electron/materialIntelligenceSnapshotSmoke.js",
    "test:material-library-extended-types": "npm run build:electron && node dist/electron/materialLibraryExtendedTypesSmoke.js",
    "test:trial-mix": "npm run build:electron && node dist/electron/trialMixSmoke.js",
    "test:trial-mix-v2": "npm run build:electron && node dist/electron/trialMixV2MigrationSmoke.js",
    "test:trial-workflow": "npm run build:electron && node dist/electron/trialWorkflowSmoke.js",
    "test:trial-revision-feedback-contract": "npm run build:electron && node dist/electron/trialMixV2RevisionFeedbackContractSmoke.js",
    "test:backup-restore": "npm run build:electron && node dist/electron/backupRestoreSmoke.js",
    "test:licensing-e2e": "node apps/license-manager/licenseE2E.js",
    "test:v11-release-identity": "node tools/verify-v11-release-identity.mjs",
    "test:v11-packaging-contract": "node tools/verify-v11-packaging.mjs",
    "dist:win": "npm run test:v11-release-identity && npm run build && npm run build:engine:win && electron-builder --config electron-builder.json --win --publish never && npm run test:v11-packaging-contract",
    "dist:license-manager:win": "electron-builder --config electron-builder.license-manager.json --win --publish never"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "latest",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "echarts": "latest",
    "better-sqlite3": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "cross-env": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  },
  "keywords": ["concrete", "mix-design", "aci", "electron", "react", "python", "sqlite"],
  "author": "Erfan Amiri / Tolou",
  "license": "UNLICENSED"
}
